  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": [
      "ES2020"
    ],
    "types": [
      "miniprogram-api-typings"
    ],
    "skipLibCheck": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "tests/**/*.ts"
  ]
}
